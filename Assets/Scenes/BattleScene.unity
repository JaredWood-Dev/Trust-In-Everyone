    - {fileID: 3422784498254569694, guid: 062e94bd414dc9148bd01909e90bd663, type: 3}
    - {fileID: 3422784498254569694, guid: 062e94bd414dc9148bd01909e90bd663, type: 3}
    - {fileID: 3422784498254569694, guid: 062e94bd414dc9148bd01909e90bd663, type: 3}
    - {fileID: 3422784498254569694, guid: 062e94bd414dc9148bd01909e90bd663, type: 3}
    - {fileID: 3422784498254569694, guid: 062e94bd414dc9148bd01909e90bd663, type: 3}
    - {fileID: 3422784498254569694, guid: 062e94bd414dc9148bd01909e90bd663, type: 3}
    - {fileID: 3422784498254569694, guid: 062e94bd414dc9148bd01909e90bd663, type: 3}
    - {fileID: 3422784498254569694, guid: 062e94bd414dc9148bd01909e90bd663, type: 3}
    - {fileID: 3422784498254569694, guid: 062e94bd414dc9148bd01909e90bd663, type: 3}
    - {fileID: 3847848324482477435, guid: ab3339d6e6fce0b43a002ac6bf54a731, type: 3}
    - {fileID: 3847848324482477435, guid: ab3339d6e6fce0b43a002ac6bf54a731, type: 3}
    - {fileID: 3847848324482477435, guid: ab3339d6e6fce0b43a002ac6bf54a731, type: 3}
    - {fileID: 3847848324482477435, guid: ab3339d6e6fce0b43a002ac6bf54a731, type: 3}
    - {fileID: 3847848324482477435, guid: ab3339d6e6fce0b43a002ac6bf54a731, type: 3}
    - {fileID: 3847848324482477435, guid: ab3339d6e6fce0b43a002ac6bf54a731, type: 3}
  timeToNextEnemy: 0.5
  currentWaveIndex: 0
  enemyCount: 0
  wave1Dialogue:
    Sentences:
    - CurrentSpeaker: {fileID: 11400000, guid: 7a3636c8cddaa5a4b8a5bbac76714ddc, type: 2}
      displaySpeaker: 1
      Sentence: Everyone stop. . . We are being watched. Get ready for a fight.
    - CurrentSpeaker: {fileID: 11400000, guid: 14dfecf4578e88c40bc8c0241cf975b7, type: 2}
      displaySpeaker: 1
      Sentence: Son, let's get your powers back.
    - CurrentSpeaker: {fileID: 11400000, guid: c273d8a0f208b8f4ab89f8fcf8a8cef4, type: 2}
      displaySpeaker: 1
      Sentence: But.. without them, how can I defend you?
    - CurrentSpeaker: {fileID: 11400000, guid: 14dfecf4578e88c40bc8c0241cf975b7, type: 2}
      displaySpeaker: 1
      Sentence: Trust in everyone Coal, we are here for you in your time of need.
  wave2Dialogue:
    Sentences:
    - CurrentSpeaker: {fileID: 11400000, guid: 7a3636c8cddaa5a4b8a5bbac76714ddc, type: 2}
      displaySpeaker: 1
      Sentence: Everyone watch out, the cultists are making their move...
    - CurrentSpeaker: {fileID: 11400000, guid: 9d44a0cbf16aa474eb5733ecbc981408, type: 2}
      displaySpeaker: 1
      Sentence: Jordgar! The Earth Master!
    - CurrentSpeaker: {fileID: 11400000, guid: 14dfecf4578e88c40bc8c0241cf975b7, type: 2}
      displaySpeaker: 1
      Sentence: Hm?
    - CurrentSpeaker: {fileID: 11400000, guid: 9d44a0cbf16aa474eb5733ecbc981408, type: 2}
      displaySpeaker: 1
      Sentence: You pathetic fat old man! You had so much potential so much POWER
        but you threw it all away.
    - CurrentSpeaker: {fileID: 11400000, guid: 7a3636c8cddaa5a4b8a5bbac76714ddc, type: 2}
      displaySpeaker: 1
      Sentence: Back off Dad! He could lift twenty times your weight, hike a mountain,
        and still return to make dinner.
    - CurrentSpeaker: {fileID: 11400000, guid: 14dfecf4578e88c40bc8c0241cf975b7, type: 2}
      displaySpeaker: 1
      Sentence: I would consider settling down to raise a family the better choice
        than chasing glory.
    - CurrentSpeaker: {fileID: 11400000, guid: 9d44a0cbf16aa474eb5733ecbc981408, type: 2}
      displaySpeaker: 1
      Sentence: Bah! We have his power now, and if we kill him, it can't be returned.
        Get him!
  wave5Dialogue:
    Sentences:
    - CurrentSpeaker: {fileID: 11400000, guid: cac929ce27388c1499cc4b2707c447b0, type: 2}
      displaySpeaker: 1
      Sentence: I've seen these guys before. Magmancers - they can throw balls of
        magma.
    - CurrentSpeaker: {fileID: 11400000, guid: c273d8a0f208b8f4ab89f8fcf8a8cef4, type: 2}
      displaySpeaker: 1
      Sentence: Magma???
    - CurrentSpeaker: {fileID: 11400000, guid: cac929ce27388c1499cc4b2707c447b0, type: 2}
      displaySpeaker: 1
      Sentence: Get behind me my scales are fire resistant.
  wave10Dialogue:
    Sentences:
    - CurrentSpeaker: {fileID: 11400000, guid: 47ede685e1a191548bf47e1b8ff7f1ec, type: 2}
      displaySpeaker: 1
      Sentence: So the little dragon came back for his powers...
    - CurrentSpeaker: {fileID: 11400000, guid: 47ede685e1a191548bf47e1b8ff7f1ec, type: 2}
      displaySpeaker: 1
      Sentence: But you had to go drag your friends and family into doing it for
        you...
    - CurrentSpeaker: {fileID: 11400000, guid: 47ede685e1a191548bf47e1b8ff7f1ec, type: 2}
      displaySpeaker: 1
      Sentence: Your nothing.
    - CurrentSpeaker: {fileID: 11400000, guid: c273d8a0f208b8f4ab89f8fcf8a8cef4, type: 2}
      displaySpeaker: 1
      Sentence: ...
    - CurrentSpeaker: {fileID: 11400000, guid: 36e312694381ea04a916dbf7fb703c6d, type: 2}
      displaySpeaker: 1
      Sentence: You have no right to use Coal's powers like this!
    - CurrentSpeaker: {fileID: 11400000, guid: 14dfecf4578e88c40bc8c0241cf975b7, type: 2}
      displaySpeaker: 1
      Sentence: We were not dragged here, we are Coal's friends and family, we are
        his clan.
    - CurrentSpeaker: {fileID: 11400000, guid: cac929ce27388c1499cc4b2707c447b0, type: 2}
      displaySpeaker: 1
      Sentence: And as a clan we work together, we build eachother up, not teat eachother
        down.
    - CurrentSpeaker: {fileID: 11400000, guid: 14dfecf4578e88c40bc8c0241cf975b7, type: 2}
      displaySpeaker: 1
      Sentence: I will ask only once. Please return my son's powers. They are not
        yours to abuse.
    - CurrentSpeaker: {fileID: 11400000, guid: 47ede685e1a191548bf47e1b8ff7f1ec, type: 2}
      displaySpeaker: 1
      Sentence: Do you think I'm going to listen to you? Let me show the fat old
        man what these powers are truly capable of!
  postBossDialogue:
    Sentences:
    - CurrentSpeaker: {fileID: 11400000, guid: 7a3636c8cddaa5a4b8a5bbac76714ddc, type: 2}
      displaySpeaker: 1
      Sentence: Jordgar! There's your opening, take Coal's powers back!
    - CurrentSpeaker: {fileID: 11400000, guid: 14dfecf4578e88c40bc8c0241cf975b7, type: 2}
      displaySpeaker: 1
      Sentence: Are you ready son?
    - CurrentSpeaker: {fileID: 11400000, guid: c273d8a0f208b8f4ab89f8fcf8a8cef4, type: 2}
      displaySpeaker: 1
      Sentence: Yes!
    - CurrentSpeaker: {fileID: 11400000, guid: 47ede685e1a191548bf47e1b8ff7f1ec, type: 2}
      displaySpeaker: 1
      Sentence: No no no NOOOOOOOOOOOOO
    - CurrentSpeaker: {fileID: 11400000, guid: 47ede685e1a191548bf47e1b8ff7f1ec, type: 2}
      displaySpeaker: 1
      Sentence: ...how...
    - CurrentSpeaker: {fileID: 11400000, guid: 47ede685e1a191548bf47e1b8ff7f1ec, type: 2}
      displaySpeaker: 1
      Sentence: ...how could I be defeated by you? i deserve these powers!
    - CurrentSpeaker: {fileID: 11400000, guid: 14dfecf4578e88c40bc8c0241cf975b7, type: 2}
      displaySpeaker: 1
      Sentence: Son, how do you feel?
    - CurrentSpeaker: {fileID: 11400000, guid: c273d8a0f208b8f4ab89f8fcf8a8cef4, type: 2}
      displaySpeaker: 1
      Sentence: Like everything hurts... but good. It feels like I'm home again.
    - CurrentSpeaker: {fileID: 11400000, guid: 14dfecf4578e88c40bc8c0241cf975b7, type: 2}
      displaySpeaker: 1
      Sentence: Alright everyone, why don't we go home. I'll get dinner started!
    - CurrentSpeaker: {fileID: 11400000, guid: c273d8a0f208b8f4ab89f8fcf8a8cef4, type: 2}
      displaySpeaker: 1
      Sentence: Ooh! Could it be spagetti?
    - CurrentSpeaker: {fileID: 11400000, guid: 14dfecf4578e88c40bc8c0241cf975b7, type: 2}
      displaySpeaker: 1
      Sentence: Sure thing bud!
    - CurrentSpeaker: {fileID: 11400000, guid: 21013471d9a666f4487a75adbc2d8538, type: 2}
      displaySpeaker: 0
      Sentence: Thank You for Playing Trust in Everyone. Hope you enjoted.
  boss: {fileID: 2377364235533325730, guid: 585c0f45c68691c47b0d8efbaf46daa8, type: 3}
  spawnPositions:
  - {x: 60, y: 10}
  - {x: 0, y: -45}
  - {x: -60, y: 10}
  - {x: 0, y: 48}
